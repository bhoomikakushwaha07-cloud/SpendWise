digraph UseCase {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=9];

    user [label="User", shape=plaintext, fontsize=14];

    subgraph cluster_system {
        label="SpendWise System";
        style="rounded"; color="#333333";

        uc1 [label="Add Income /\nExpense", shape=ellipse, style=filled, fillcolor="#bcdcf4"];
        uc2 [label="View / Search / Sort\nTransactions", shape=ellipse, style=filled, fillcolor="#bcdcf4"];
        uc3 [label="Delete\nTransaction", shape=ellipse, style=filled, fillcolor="#bcdcf4"];
        uc4 [label="Set Category\nBudget", shape=ellipse, style=filled, fillcolor="#b9e6a4"];
        uc5 [label="Check Budget\nUtilization", shape=ellipse, style=filled, fillcolor="#b9e6a4"];
        uc6 [label="Add\nSubscription", shape=ellipse, style=filled, fillcolor="#f9e8ba"];
        uc7 [label="Cancel / Delete\nSubscription", shape=ellipse, style=filled, fillcolor="#f9e8ba"];
        uc8 [label="View Monthly / Yearly\nSubscription Cost", shape=ellipse, style=filled, fillcolor="#f9e8ba"];
        uc9 [label="Spending-by-Category\nReport", shape=ellipse, style=filled, fillcolor="#f0b8b8"];
        uc10 [label="Combined Activity\nFeed", shape=ellipse, style=filled, fillcolor="#f0b8b8"];
        uc11 [label="Monthly Financial\nOutlook", shape=ellipse, style=filled, fillcolor="#f0b8b8"];
    }

    user -> uc1; user -> uc2; user -> uc3;
    user -> uc4; user -> uc5;
    user -> uc6; user -> uc7; user -> uc8;
    user -> uc9; user -> uc10; user -> uc11;

    uc5 -> uc1 [style=dashed, label="depends on", dir=back];
    uc9 -> uc1 [style=dashed, label="depends on", dir=back];
    uc11 -> uc1 [style=dashed, label="depends on", dir=back];
    uc11 -> uc8 [style=dashed, label="depends on", dir=back];
}
