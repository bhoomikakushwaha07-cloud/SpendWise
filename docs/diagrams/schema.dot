digraph Schema {
    rankdir=LR;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=record, style=filled, fillcolor="#f5f5f5"];

    transactions [fillcolor="#bcdcf4", label="{transactions.csv|id : String (PK)\ltype : ENUM(INCOME,EXPENSE)\lamount : double\lcategory : String\ldate : LocalDate (yyyy-MM-dd)\ldescription : String\l}"];

    budgets [fillcolor="#b9e6a4", label="{budgets.csv|category : String (PK)\llimitAmount : double\l}"];

    subscriptions [fillcolor="#f9e8ba", label="{subscriptions.csv|id : String (PK)\lname : String\lamount : double\lbillingCycle : ENUM(WEEKLY,MONTHLY,\l  QUARTERLY,YEARLY)\lcategory : String\lstartDate : LocalDate\lactive : boolean\l}"];

    transactions -> budgets [style=dashed, dir=none, arrowhead=none, label="category  (logical link,\nnot a strict foreign key)"];
    subscriptions -> budgets [style=dashed, dir=none, arrowhead=none, label="category  (logical link)"];

    label="SpendWise Storage Schema  (flat CSV files — no relational DB is used)";
    labelloc="t";
    fontsize=14;
}
