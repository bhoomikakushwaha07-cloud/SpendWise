digraph Architecture {
    rankdir=TB;
    fontname="Helvetica";
    node [fontname="Helvetica", shape=box, style="rounded,filled", color="#333333"];
    edge [fontname="Helvetica", fontsize=10];
    graph [splines=true, nodesep=0.35, ranksep=0.55];

    subgraph cluster_ui {
        label="Presentation Layer";
        style="rounded,filled"; color="#dbe9f6"; fillcolor="#eef5fc";
        Main [label="Main.java\n(Console Menus / CLI)", fillcolor="#bcdcf4"];
    }

    subgraph cluster_service {
        label="Service Layer  —  Business Logic";
        style="rounded,filled"; color="#dff0d8"; fillcolor="#eef8ea";
        TS [label="TransactionService\n(Module 1)", fillcolor="#b9e6a4"];
        BS [label="BudgetService\n(Module 2)", fillcolor="#b9e6a4"];
        SS [label="SubscriptionService\n(Module 3)", fillcolor="#b9e6a4"];
        RS [label="ReportService\n(Module 4)", fillcolor="#b9e6a4"];
    }

    subgraph cluster_model {
        label="Model Layer  —  Domain Objects";
        style="rounded,filled"; color="#fbeecb"; fillcolor="#fdf6e3";
        FR [label="FinancialRecord\n<<abstract>>", fillcolor="#f7dfa1", shape=box];
        TX [label="Transaction", fillcolor="#f9e8ba"];
        SUB [label="Subscription", fillcolor="#f9e8ba"];
        BUD [label="Budget", fillcolor="#f9e8ba"];
        REP [label="Reportable\n<<interface>>", fillcolor="#f7dfa1"];
    }

    subgraph cluster_storage {
        label="Storage Layer  —  Persistence";
        style="rounded,filled"; color="#f4dede"; fillcolor="#fbecec";
        CFH [label="CSVFileHandler", fillcolor="#f0b8b8"];
        TSTORE [label="TransactionStorage", fillcolor="#f4cccc"];
        BSTORE [label="BudgetStorage", fillcolor="#f4cccc"];
        SSTORE [label="SubscriptionStorage", fillcolor="#f4cccc"];
    }

    subgraph cluster_files {
        label="Data Files (CSV)";
        style="rounded,filled"; color="#e2e2e2"; fillcolor="#f2f2f2";
        F1 [label="transactions.csv", shape=cylinder, fillcolor="#dddddd"];
        F2 [label="budgets.csv", shape=cylinder, fillcolor="#dddddd"];
        F3 [label="subscriptions.csv", shape=cylinder, fillcolor="#dddddd"];
    }

    Main -> TS; Main -> BS; Main -> SS; Main -> RS;

    BS -> TS [style=dashed, label="uses"];
    RS -> TS [style=dashed, label="uses"];
    RS -> BS [style=dashed, label="uses"];
    RS -> SS [style=dashed, label="uses"];

    TS -> TSTORE; BS -> BSTORE; SS -> SSTORE;
    TSTORE -> CFH; BSTORE -> CFH; SSTORE -> CFH;
    CFH -> F1; CFH -> F2; CFH -> F3;

    TX -> FR [style=dashed, arrowhead=empty, label="extends"];
    SUB -> FR [style=dashed, arrowhead=empty, label="extends"];
    TX -> REP [style=dotted, arrowhead=empty, label="implements"];
    SUB -> REP [style=dotted, arrowhead=empty, label="implements"];

    TS -> TX [style=dashed, label="manipulates"];
    BS -> BUD [style=dashed, label="manipulates"];
    SS -> SUB [style=dashed, label="manipulates"];
}
